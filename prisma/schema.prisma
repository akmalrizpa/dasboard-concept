// BeautyLoka — Prisma Schema
// Beauty e-commerce webstore (Sociolla-style) + Admin Dashboard

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  image     String?
  icon      String? // emoji icon fallback
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  isFeatured Boolean  @default(false)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique
  description   String
  price         Int // harga jual (IDR)
  originalPrice Int? // harga sebelum diskon (IDR)
  stock         Int         @default(0)
  rating        Float       @default(0)
  reviewCount   Int         @default(0)
  sold          Int         @default(0)
  image         String // main image URL
  isFlashSale   Boolean     @default(false)
  flashPrice    Int?
  flashStock    Int         @default(0)
  flashSold     Int         @default(0)
  isActive      Boolean     @default(true)
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  brandId       String
  brand         Brand       @relation(fields: [brandId], references: [id])
  reviews       Review[]
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([isFlashSale])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    String
  rating    Int // 1-5
  comment   String
  createdAt DateTime @default(now())

  @@index([productId])
}

model Customer {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  phone      String?
  address    String?
  city       String?
  postalCode String?
  orders     Order[]
  createdAt  DateTime @default(now())
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  customerName  String
  email         String
  phone         String
  address       String
  city          String
  postalCode    String
  notes         String?
  subtotal      Int
  shippingCost  Int         @default(0)
  discount      Int         @default(0)
  voucherCode   String? // kode voucher yang dipakai (snapshot)
  total         Int
  paymentMethod String
  status        String      @default("PENDING") // PENDING | CONFIRMED | PROCESSED | SHIPPED | DELIVERED | CANCELLED
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String // snapshot nama produk
  image     String // snapshot gambar produk
  quantity  Int
  price     Int // harga satari saat pembelian

  @@index([orderId])
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String // sha256(salt + password)
  salt      String
  name      String
  createdAt DateTime @default(now())
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  image     String
  link      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
}

// ===== Konfigurasi dinamis (key-value, value berupa JSON string) =====
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String // JSON-encoded (string, number, boolean, atau array/object)
  updatedAt DateTime @updatedAt
}

// ===== Jendela flash sale (countdown mengikuti endsAt) =====
model FlashSale {
  id        String   @id @default(cuid())
  title     String   @default("Flash Sale")
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== Metode pengiriman & tarif ongkir (dikelola admin) =====
model ShippingMethod {
  id        String   @id @default(cuid())
  code      String   @unique // REGULER, KARGO, INSTAN
  label     String
  eta       String
  cost      Int // ongkir (IDR)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
}

// ===== Metode pembayaran (dikelola admin) =====
model PaymentMethod {
  id        String   @id @default(cuid())
  code      String   @unique // BCA, GOPAY, QRIS, COD, ...
  label     String
  group     String // Transfer Bank | E-Wallet | Lainnya
  desc      String
  fee       Int      @default(0) // biaya tambahan, mis. COD 2500
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
}

// ===== Voucher / kode promo =====
model Voucher {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  type        String // PERCENT | FIXED | FREE_SHIPPING
  value       Int      @default(0) // PERCENT: persen (10 = 10%), FIXED: nominal IDR
  minPurchase Int      @default(0)
  maxDiscount Int      @default(0) // batas diskon utk PERCENT; 0 = tanpa batas
  usageLimit  Int      @default(0) // 0 = tanpa batas pemakaian
  usedCount   Int      @default(0)
  startsAt    DateTime @default(now())
  expiresAt   DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== Artikel Beauty Journal =====
model Article {
  id        String   @id @default(cuid())
  emoji     String   @default("📖")
  tag       String
  title     String
  excerpt   String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
